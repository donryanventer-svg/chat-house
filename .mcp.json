{
  "mcpServers": {
    "google-photos": {
      "command": "npx",
      "args": ["-y", "google-photos-mcp", "--stdio"],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_REDIRECT_URI": "${GOOGLE_REDIRECT_URI:-http://localhost:3000/auth/callback}"
      }
    }
  }
}
